--- !u!114 &931302016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 931302014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 04e2105fbe0fe2f438bda69065f29198, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MirrorInteractive
  interactionRange: 2
  interactionPrompt: Press E to interact
  horrorQuotes:
  - "Chi\u1EBFc b\xF3ng trong g\u01B0\u01A1ng d\u01B0\u1EDDng nh\u01B0 chuy\u1EC3n \u0111\u1ED9ng ch\u1EADm h\u01A1n b\u1EA1n m\u1ED9t nh\u1ECBp..."
  - "B\u1EA1n nh\xECn th\u1EB3ng v\xE0o m\u1EAFt m\xECnh trong g\u01B0\u01A1ng, nh\u01B0ng c\xF3 c\u1EA3m gi\xE1c ng\u01B0\u1EDDi b\xEAn trong \u0111ang quan s\xE1t b\u1EA1n t\u1EEB m\u1ED9t th\u1EBF gi\u1EDBi kh\xE1c..."
  - "M\u1ED9t l\xE0n h\u01A1i th\u1EDF l\u1EA1nh bu\u1ED1t ph\u1EA3 m\u1EDD m\u1EB7t k\xEDnh... t\u1EEB ph\xEDa B\xCAN TRONG t\u1EA5m g\u01B0\u01A1ng."
  - "D\u01B0\u1EDBi l\u1EDBp tr\xE1ng th\u1EE7y b\u1EA1c, b\u1EA1n th\u1EA5y nh\u1EEFng v\u1EBFt c\xE0o m\xF3ng tay ch\u1EB1ng ch\u1ECBt c\u1ED1 c\xE0o ra ngo\xE0i."
  - "\"\u0110\u1EEBng quay l\u01B0ng l\u1EA1i v\u1EDBi ta...\" - M\u1ED9t ti\u1EBFng th\xEC th\u1EA7m v\xF4 h\xECnh nh\u01B0 v\u1ECDng ra t\u1EEB s\xE2u th\u1EB3m trong g\u01B0\u01A1ng."
  - "H\xECnh \u1EA3nh ph\u1EA3n chi\u1EBFu c\u1EE7a b\u1EA1n m\u1EC9m c\u01B0\u1EDDi, d\xF9 khu\xF4n m\u1EB7t b\u1EA1n \u0111ang t\xE1i m\xE9t v\xEC s\u1EE3 h\xE3i."
  - "T\u1EA5m g\u01B0\u01A1ng rung rinh nh\u1EB9 nh\u01B0 m\u1EB7t n\u01B0\u1EDBc \u0111en th\u1EABm, nh\u01B0 th\u1EC3 c\xF3 b\xE0n tay \u0111ang \xE1p v\xE0o t\u1EEB ph\xEDa b\xEAn kia..."
  customQuote: "T\u1EA5m g\u01B0\u01A1ng d\xE0i m\u1EA1 v\xE0ng sang tr\u1ECDng c\u1EE7a ph\xF2ng \u0103n qu\xFD t\u1ED9c. Chi\u1EBFc b\xE0n \u0103n d\xE0i ph\u1EA3n chi\u1EBFu trong g\u01B0\u01A1ng mang v\u1EBB th\xEA l\u01B0\u01A1ng c\u1EE7a m\u1ED9t b\u1EEFa ti\u1EC7c kh\xF4ng ng\u01B0\u1EDDi tr\u1EDF v\u1EC1."
  inspectSound: {fileID: 0}
