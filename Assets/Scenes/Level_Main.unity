  m_Script: {fileID: 11500000, guid: 75e209c00d4823742b08452f875d09c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeClue
  interactionRange: 2.5
  interactionPrompt: "\u0110\u1ECDc c\u1ED5 th\u01B0 Th\u01B0 Vi\u1EC7n [E / Ch\u1EA1m]"
  clueId: clue_library_occult
  clueText: "M\u1EA9u gi\u1EA5y c\u1ED5 th\u01B0 Th\u01B0 Vi\u1EC7n - Nghi th\u1EE9c C\xF5i G\u01B0\u01A1ng:\n\n\"\u0110\u1EC3 m\u1EDF phong \u1EA5n c\xF5i b\xF3ng t\u1ED1i, h\xE3y nh\u1EDB th\u1EE9 t\u1EF1 c\u1ED5 x\u01B0a:\n- 4 b\u1EE9c t\u01B0\u1EDDng \u0111\xE1 giam gi\u1EEF c\xE1c linh h\u1ED3n lang thang (4)\n- 2 chi\u1EBFc b\xF3ng \u0111\u1ED1i di\u1EC7n nhau trong chi\u1EBFc g\u01B0\u01A1ng ma (2)\n- 1 con dao hi\u1EBFn t\u1EBF nhu\u1ED1m m\xE1u (1)\n- 9 t\u1EA7ng lu\xE2n h\u1ED3i c\xF5i v\u0129nh h\u1EB1ng (9)\"\n\n[MANH M\u1ED0I: Gh\xE9p 4 con s\u1ED1 theo th\u1EE9 t\u1EF1 nghi th\u1EE9c -> 4219]"
