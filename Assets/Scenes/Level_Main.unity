  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75e209c00d4823742b08452f875d09c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeClue
  interactionRange: 2.5
  interactionPrompt: "\u0110\u1ECDc nh\u1EADt k\xFD c\u1EE7a Emily trong ng\u0103n k\xE9o [E / Ch\u1EA1m]"
  clueId: clue_emily_diary
  clueText: "Trang nh\u1EADt k\xFD c\u1EE7a Emily gi\u1EA5u k\xEDn trong ng\u0103n k\xE9o b\xE0n:\n\n\"Cha mang v\u1EC1 chi\u1EBFc g\u01B0\u01A1ng c\u1ED5 b\u1EB1ng v\xE0ng t\u1EEB m\u1ED9t phi\xEAn \u0111\u1EA5u gi\xE1 b\xED m\u1EADt. Cha b\u1EA3o n\xF3 \u0111\u01B0\u1EE3c \u0111\xFAc v\xE0o \u0111\xFAng N\u0102M 1894 - n\u0103m kh\u1EDFi \u0111\u1EA7u cho d\xF2ng h\u1ECD ch\xFAng ta.\n\nT\u1EEB \u0111\xEAm h\xF4m \u0111\xF3, cha lu\xF4n nh\u1ED1t m\xECnh trong ph\xF2ng v\xE0 n\xF3i chuy\u1EC7n m\u1ED9t m\xECnh tr\u01B0\u1EDBc t\u1EA5m g\u01B0\u01A1ng...\"\n\n[MANH M\u1ED0I THEN CH\u1ED0T: M\u1EADt m\xE3 k\xE9t s\u1EAFt ph\xF2ng ng\u1EE7 l\xE0 1894]"
